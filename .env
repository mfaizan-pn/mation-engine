# ----------------------------
# API Server
# ----------------------------
PORT=3000

# ----------------------------
# Rule storage provider
# Set to "minio" to enable MinIO-backed startup preload/persistence.
# Any other value (or unset) keeps storage in-memory only.
# ----------------------------
RULE_STORAGE_PROVIDER=minio

# ----------------------------
# MinIO / S3-compatible storage
# Required when RULE_STORAGE_PROVIDER=minio
# ----------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lb4EKTkoiDVevkXyCcLu
MINIO_SECRET_KEY=kNzDI9I05XkPaNtBlD2PSEQZpNciELADg2Kdro1E
MINIO_BUCKET=rule-engine
MINIO_RULE_PREFIX=rules
